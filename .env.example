# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000

# # ─── Redis ───────────────────────────────────────────────────────────────────
# # Full Redis connection URL.
# # Local:  redis://127.0.0.1:6379
# # With auth: redis://:yourpassword@127.0.0.1:6379
# # TLS (e.g. Redis Cloud): rediss://user:password@host:port
# REDIS_URL=redis://127.0.0.1:6379

# # ─── MySQL ───────────────────────────────────────────────────────────────────
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=yourpassword
# MYSQL_DB=family_car_race

# # MySQL connection pool limits
# MYSQL_POOL_MIN=2
# MYSQL_POOL_MAX=10

# # ─── JWT ─────────────────────────────────────────────────────────────────────
# # Must be at least 32 random characters in production.
# # Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars
# JWT_EXPIRES_IN=7d


# Database (currently hardcoded in database.php, but ready for .env)
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=rockstar

# Redis
REDIS_PARTYROOM_URL=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=5.0

# JWT
JWT_API_KEY=your_jwt_secret_key_here

# Admin user IDs — comma-separated IDs from the users table
# Users in this list can access /admin/* routes. No role column needed.
# Example: ADMIN_USER_IDS=1,42,100
ADMIN_USER_IDS=1,9,34

# Notifications
NOTIFY_BASE_URL=https://your-notify-service-url.com
NOTIFY_TOKEN=your_notify_token_here

# ─── BullMQ ──────────────────────────────────────────────────────────────────
# BullMQ uses the same Redis connection as REDIS_URL above.
# Separate prefix to namespace BullMQ keys away from game keys.
BULLMQ_PREFIX=fcr
